# Zero trust rule group, evaluated in strict order: the first matching pass or drop wins.
# Policy default for anything not passed here: drop established traffic and log an alert.
# The msg text of each drop is the reason shown on the dashboard.

# --- Ingress: one deliberate entry point, HTTP port 80 on the public load balancer, public API paths only
drop tcp $EXTERNAL_NET any -> $EDGE_NET !80 (msg:"Ingress blocked: port not exposed, only HTTP 80 is a public entry point"; flow:to_server; sid:1000001; rev:1;)
drop udp $EXTERNAL_NET any -> $EDGE_NET any (msg:"Ingress blocked: UDP is not exposed"; sid:1000002; rev:1;)
drop icmp $EXTERNAL_NET any -> $EDGE_NET any (msg:"Ingress blocked: ICMP echo to the public subnets"; itype:8; sid:1000003; rev:1;)
pass http $EXTERNAL_NET any -> $EDGE_NET 80 (msg:"Ingress allowed: public API path"; flow:to_server,established; http.uri; content:"/api/"; startswith; sid:1000010; rev:1;)
drop http $EXTERNAL_NET any -> $EDGE_NET 80 (msg:"Ingress blocked: path outside the public API, direct service route attempted"; flow:to_server,established; sid:1000011; rev:1;)

# --- Egress: TLS to allowlisted domains only
%{ for i, d in egress_allowed_domains ~}
pass tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"Egress allowed: ${d}"; flow:to_server,established; tls.sni; content:"${d}"; nocase; startswith; endswith; sid:${1000100 + i}; rev:1;)
%{ endfor ~}
drop tls $HOME_NET any -> $EXTERNAL_NET any (msg:"Egress blocked: TLS to a domain outside the allowlist"; flow:to_server,established; sid:1000200; rev:1;)
drop http $HOME_NET any -> $EXTERNAL_NET any (msg:"Egress blocked: plain HTTP leaving the VPC"; flow:to_server,established; sid:1000201; rev:1;)
drop tcp $HOME_NET any -> $EXTERNAL_NET !443 (msg:"Egress blocked: TCP port other than 443"; flow:to_server; sid:1000202; rev:1;)
drop udp $HOME_NET any -> $EXTERNAL_NET any (msg:"Egress blocked: UDP leaving the VPC"; sid:1000203; rev:1;)
